FROM rust:1.78-slim-bookworm AS builder

WORKDIR /app
COPY cathedral-agent .

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates curl python3 python3-pip netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Instalar dependências Python para bridge (se necessário)
COPY cathedral_agent_bridge.py /opt/cathedral/
RUN pip3 install --break-system-packages --no-cache-dir httpx pydantic

WORKDIR /app
COPY --from=builder /app/target/release/cathedral-agent-runtime /usr/local/bin/
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8001
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["cathedral-agent-runtime"]