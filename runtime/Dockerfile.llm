# ============================================================================
# Stage: Quantização GGUF (usando llama.cpp)
# ============================================================================
FROM base AS quantize-gguf
RUN apt-get update && apt-get install -y build-essential cmake git
WORKDIR /build
RUN git clone https://github.com/ggerganov/llama.cpp && cd llama.cpp && make
COPY models/cathedral-llm-v28.3.safetensors /models/
# Converte para GGUF FP16
RUN python3 llama.cpp/convert.py /models/cathedral-llm-v28.3.safetensors --outfile /models/cathedral-llm-v28.3.fp16.gguf
# Quantização Q4_K_M
RUN llama.cpp/quantize /models/cathedral-llm-v28.3.fp16.gguf /models/cathedral-llm-v28.3.Q4_K_M.gguf Q4_K_M

# ============================================================================
# Stage: Quantização AWQ (usando AutoAWQ)
# ============================================================================
FROM base AS quantize-awq
RUN pip install autoawq transformers
COPY models/cathedral-llm-v28.3 /models/
WORKDIR /workspace
RUN python3 -c "from awq import AutoAWQForCausalLM; model = AutoAWQForCausalLM.from_pretrained('/models'); model.quantize(quant_config={ 'zero_point': True, 'q_group_size': 128, 'w_bit': 4, 'version': 'GEMM' })"