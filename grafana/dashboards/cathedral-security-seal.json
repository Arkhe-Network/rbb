{
  "dashboard": {
    "id": null,
    "title": "Cathedral ARKHE — Security / Capability Tokens + Seal",
    "tags": [
      "cathedral",
      "security",
      "tokens",
      "seal",
      "access"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Access Denials (Last Hour)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "increase(security_access_denials_total[1h])",
            "legendFormat": "Denials",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 10 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Active Capability Tokens",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [
          {
            "expr": "capability_tokens_active",
            "legendFormat": "Active Tokens",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        }
      },
      {
        "id": 3,
        "title": "Token Revocation Rate",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "rate(capability_tokens_revoked_total[5m])",
            "legendFormat": "Revocations/sec",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps"
          }
        }
      },
      {
        "id": 4,
        "title": "Seal Validation Latency (P95)",
        "type": "graph",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(seal_validation_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "format": "time_series"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 5,
        "title": "Seal Access Approvals vs Denials",
        "type": "bargauge",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "sum(rate(seal_access_approvals_total[5m]))",
            "legendFormat": "Approvals",
            "format": "time_series"
          },
          {
            "expr": "sum(rate(security_access_denials_total[5m]))",
            "legendFormat": "Denials",
            "format": "time_series"
          }
        ],
        "options": {
          "orientation": "horizontal"
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    }
  },
  "overwrite": true
}
